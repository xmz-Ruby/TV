<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 焦点时使用半透明白色背景 -->
    <solid android:color="@color/white_40" />

    <corners android:radius="6dp" />

    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

    <!-- 明显的白色边框 -->
    <stroke
        android:width="2dp"
        android:color="@color/white" />

</shape>
